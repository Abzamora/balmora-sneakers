# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. Never commit the real .env
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (free M0 cluster) - get this from Atlas > Connect > Drivers
MONGO_URI=mongodb+srv://<user>:L049cSuNkd2e5dLq@cluster0.mongodb.net/sneaker_store?retryWrites=true&w=majority

# JSON Web Token
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (free tier - 25GB storage/bandwidth) for product image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS - the deployed frontend origin(s), comma separated
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# WhatsApp business number in international format, no "+" or spaces
WHATSAPP_NUMBER=15551234567
