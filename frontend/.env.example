# In development this is left blank (Vite proxy in vite.config.js handles it).
# In production, set this to your deployed backend URL, e.g.:
# VITE_API_URL=https://sneaker-store-api.onrender.com/api
VITE_API_URL=/api

# WhatsApp business number in international format, no "+" or spaces
VITE_WHATSAPP_NUMBER=15551234567
